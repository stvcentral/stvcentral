APP_ORIGIN=https://stvcentral.com
SITE_DOMAIN=stvcentral.com
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OWNER_KEY=REPLACE_WITH_A_RANDOM_64_CHARACTER_KEY
# Keep 0 unless your host strips client-supplied forwarded headers and sets its own.
TRUST_PROXY=0
CUSTOMER_DB_PATH=/app/runtime/customers.sqlite
MUSIC_DIR=/app/private/music
