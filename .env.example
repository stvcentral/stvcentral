APP_ORIGIN=https://stvcentral.com
SITE_DOMAIN=stvcentral.com
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OWNER_KEY=REPLACE_WITH_A_RANDOM_64_CHARACTER_KEY
# Keep 0 unless your host strips client-supplied forwarded headers and sets its own.
TRUST_PROXY=0
CUSTOMER_DB_PATH=/app/runtime/customers.sqlite
MUSIC_DIR=/app/private/music

# Keep disabled until persistent account storage, provider approval and end-to-end tests are complete.
SOCIAL_LOGIN_ENABLED=0
CUSTOMER_STORAGE_READY=0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_GRAPH_VERSION=v27.0
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# PKCS#8 key held only in the server environment; literal \n separators are supported.
APPLE_PRIVATE_KEY=
